rules_version = '2';

// Firestore is written only by Cloud Functions through the Admin SDK, which
// bypasses these rules. Two things are readable by anyone: published posts
// (the website builds from them and the app reads them, both through the
// REST endpoint without credentials, so a list query must ask for
// status == "published") and the website's settings document, which the
// site listens to in real time so a change (such as hiding the submit
// button) shows without a reload. Everything else (members, submissions,
// passkeys, the reactions and comments under a post) goes through the REST
// API, except direct message threads, which their two members read live.
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{slug} {
      allow read: if resource.data.status == "published";
      allow write: if false;
    }
    match /settings/site {
      allow read: if true;
      allow write: if false;
    }
    // Direct messages: a thread's members read it and its messages live;
    // the functions do all the writing (threads.js).
    match /threads/{thread} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow write: if false;
      match /messages/{message} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(thread)).data.members;
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
