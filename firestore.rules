rules_version = '2';

// Firestore is read and written only by Cloud Functions through the Admin
// SDK, which bypasses these rules. The review page and the app reach
// submissions through the REST API, so no client access is allowed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
