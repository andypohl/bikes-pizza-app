# Copy to functions/.env (git-ignored). Non-secret parameters only.
# Which environment this is ("development" or "production"): the website
# of the same environment is rebuilt after a post is published or edited.
# The deploy workflow writes it from the GitHub environment.
SITE_ENVIRONMENT=development
# Where published posts link to (the website of this environment).
SITE_URL=

# Email (submission notices, concern reports, account deletion
# confirmations, conversations continued by email) goes out through
# Cloudflare Email Service. The API token (a Cloudflare API token with
# "Email Sending: Edit") is a secret, set with:
#   firebase functions:secrets:set CLOUDFLARE_EMAIL_TOKEN
# The Cloudflare account the sending domain is onboarded in. Empty skips
# every email.
CLOUDFLARE_ACCOUNT_ID=
# Sender, e.g. "bikes.pizza <robot@your-sending-domain>"; the domain must
# be onboarded to Email Sending. Empty means the bikes.pizza mailer.
MAIL_FROM_EMAIL=
# Who to tell about new submissions. Leave empty to skip that email.
SUBMISSION_NOTIFY_EMAIL=


# Link to the review page put in the notification email. Empty means
# https://submissions.bikes.pizza/.
REVIEW_PAGE_URL=

# After the scheduled functions post something they ask GitHub to rebuild
# the website with a repository_dispatch. The token is a secret, set with:
#   firebase functions:secrets:set GITHUB_DISPATCH_TOKEN
# (a fine-grained personal access token for the repository with
# "Contents: read and write"). The repository defaults to this one.
GITHUB_REPOSITORY=

# Origins besides the website's own hosts that may use passkeys: the native
# apps. Android presents android:apk-key-hash:<base64url SHA-256 of the
# signing certificate>; iOS presents the website origin, which is allowed
# already. Comma-separated; empty allows only the website.
PASSKEY_ORIGINS=
