# Copy to functions/.env (git-ignored). Non-secret parameters only.
# The Ghost site's API URL from Ghost Admin > Settings > Integrations > your
# custom integration, without a trailing slash.
GHOST_ADMIN_API_URL=https://your-site.ghost.io

# The Admin API key is a secret and is NOT read from this file. Set it with:
#   firebase functions:secrets:set GHOST_ADMIN_API_KEY

# New member submissions are emailed through Mailgun. The API key is a
# secret, set with:
#   firebase functions:secrets:set MAILGUN_API_KEY
# The sending domain (verified in Mailgun, or the sandbox domain for tests;
# sandbox domains only deliver to authorized recipients):
MAILGUN_DOMAIN=
# API base; EU-region accounts use https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# Recipient. Leave empty to skip the email.
SUBMISSION_NOTIFY_EMAIL=
# Sender, e.g. "Pizza Predator <submissions@your-domain>". Empty means
# postmaster@<MAILGUN_DOMAIN>.
SUBMISSION_FROM_EMAIL=

# Ghost staff account (its email) that submission drafts are attributed to,
# so they show under that user in Ghost Admin. Leave empty for Ghost's
# default author. Not a secret.
SUBMISSION_AUTHOR_EMAIL=

# Link to the review page put in the notification email. Empty derives
# https://<project>.web.app/review/ from the project.
REVIEW_PAGE_URL=
