# Copy to functions/.env (git-ignored). Non-secret parameters only.
# The Ghost site's API URL from Ghost Admin > Settings > Integrations > your
# custom integration, without a trailing slash.
GHOST_ADMIN_API_URL=https://your-site.ghost.io

# The Admin API key is a secret and is NOT read from this file. Set it with:
#   firebase functions:secrets:set GHOST_ADMIN_API_KEY

# Where to email new member submissions. Leave empty to skip the email.
# The SMTP credentials are a secret, set with:
#   firebase functions:secrets:set SMTP_URL
# with a value like smtps://user%40example.com:password@smtp.example.com:465
# (Mailgun: its domain's SMTP login at smtp.mailgun.org:465; Gmail: an app
# password at smtp.gmail.com:465).
SUBMISSION_NOTIFY_EMAIL=

# Sender address for that email. Empty uses the SMTP user name; set it when
# that is a postmaster-style login and the provider allows another address
# on the same domain.
SUBMISSION_FROM_EMAIL=

# Ghost staff account (its email) that submission drafts are attributed to,
# so they show under that user in Ghost Admin. Leave empty for Ghost's
# default author. Not a secret.
SUBMISSION_AUTHOR_EMAIL=
