# Copy to functions/.env (git-ignored). Non-secret parameters only.
# Approved submissions are published to Sanity. The write token (an Editor
# token for the project) is a secret and is NOT read from this file; set it
# with:
#   firebase functions:secrets:set SANITY_WRITE_TOKEN
# The project and dataset default to the ones in the repo; override here to
# publish elsewhere. SITE_URL is where published posts link to.
SANITY_PROJECT_ID=
SANITY_DATASET=
SITE_URL=

# New member submissions are emailed through Mailgun. The API key is a
# secret, set with:
#   firebase functions:secrets:set MAILGUN_API_KEY
# The sending domain (verified in Mailgun, or the sandbox domain for tests;
# sandbox domains only deliver to authorized recipients):
MAILGUN_DOMAIN=
# API base; EU-region accounts use https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# Recipient. Leave empty to skip the email.
SUBMISSION_NOTIFY_EMAIL=
# Sender, e.g. "Pizza Predator <submissions@your-domain>". Empty means
# postmaster@<MAILGUN_DOMAIN>.
SUBMISSION_FROM_EMAIL=


# Link to the review page put in the notification email. Empty means
# https://submissions.bikes.pizza/.
REVIEW_PAGE_URL=

# After the scheduled functions post something they ask GitHub to rebuild
# the website with a repository_dispatch. The token is a secret, set with:
#   firebase functions:secrets:set GITHUB_DISPATCH_TOKEN
# (a fine-grained personal access token for the repository with
# "Contents: read and write"). The repository defaults to this one.
GITHUB_REPOSITORY=
