rules_version = '2';

// Submission photos are written only by Cloud Functions (Admin SDK, which
// bypasses these rules). Clients fetch them through the tokenised download
// URLs the REST API hands out, so no rule-based access is allowed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
