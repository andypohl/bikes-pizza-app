<?xml version="1.0" encoding="utf-8"?>
<!-- Icon for the Android 12+ system splash screen. The system masks the
     icon to a circle two thirds of its size, so this is an adaptive icon
     whose background is the splash teal (invisible on the teal window) and
     whose foreground is the logo alone, inset to fit inside that circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/splash_logo" />
</adaptive-icon>
