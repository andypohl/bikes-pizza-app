---
// One post in a gallery: the photo, with title and category revealed on
// hover. With `titleAbove` the title sits above the photo all the time and
// only the category and date appear on hover (the featured row). Shared by
// the featured row and the grid; `sizes` says how wide the tile can be so
// the browser picks a fitting rendition. The photo is cropped to 4:3 by
// CSS, placed around its focus point.
import { detailLine, categoryOf, focusPosition, postPath, responsive, TILE_RATIO, type GalleryPost } from '../lib/posts';
import { formatDate } from '../utils/format';

interface Props {
  post: GalleryPost;
  eager?: boolean;
  titleAbove?: boolean;
  sizes?: string;
}

const {
  post,
  eager = false,
  titleAbove = false,
  sizes = '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props;
const { src, srcset } = responsive(post.image);
const width = post.image.width;
const height = Math.round(width / TILE_RATIO);
const details = detailLine(post);
---

<a
  href={postPath(post)}
  class="group block overflow-hidden rounded-lg transition-all duration-300 relative"
  transition:name={`post-${post.id}`}
>
  {
    titleAbove && (
      <h3 class="text-2xl font-light tracking-wide text-center mb-3 text-ink group-hover:text-spice transition-colors duration-300">
        {post.title}
      </h3>
    )
  }
  <div class="overflow-hidden relative">
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      alt={post.title}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={`object-position: ${focusPosition(post.image)}${post.image.blur ? `; background: url(${post.image.blur}) center / cover` : ''}`}
      class="w-full h-auto aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-102"
    />
    <div class="absolute inset-0 bg-ink opacity-0 group-hover:opacity-60 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
      <div class="text-cream text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
        {!titleAbove && <h3 class="text-lg font-medium mb-1">{post.title}</h3>}
        <p class="text-sm font-light tracking-wide opacity-90">
          {categoryOf(post)} · {formatDate(post.publishedAt)}
          {post.commentCount > 0 && ` · ${post.commentCount} comment${post.commentCount === 1 ? '' : 's'}`}
        </p>
        {details && <p class="text-sm font-light tracking-wide opacity-90 mt-1">{details}</p>}
      </div>
    </div>
  </div>
</a>
