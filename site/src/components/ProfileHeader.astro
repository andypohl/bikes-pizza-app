---
// The top of a member's profile: the username, "Joined …" and their
// location, and the pizza and bike counts (each an anchor into the post
// lists below, when the page has them). With a `username` the header is
// built with the counts the build saw and refreshed from the API when the
// page loads; without one (the fallback page) it starts empty and is
// filled from the API, or says the member was not found.
interface Props {
  username?: string;
  pizzas?: number;
  bikes?: number;
}

const { username, pizzas, bikes } = Astro.props;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<header class="mb-4" data-profile data-username={username}>
  <h1 class="text-3xl font-light tracking-wide text-ink" data-username-label>
    <span data-username>{username ?? ''}</span>
  </h1>
  <p class="mt-1 text-muted font-light" data-meta hidden></p>
  <p class="mt-3 flex flex-wrap gap-3 text-sm">
    <a href="#pizzas" class="px-4 py-2 rounded-full bg-pill hover:bg-pill-hover text-ink transition-colors" data-count="pizza" hidden={pizzas === undefined}>
      {pizzas !== undefined ? plural(pizzas, 'pizza', 'pizzas') : ''}
    </a>
    <a href="#bikes" class="px-4 py-2 rounded-full bg-pill hover:bg-pill-hover text-ink transition-colors" data-count="bikes" hidden={bikes === undefined}>
      {bikes !== undefined ? plural(bikes, 'bike', 'bikes') : ''}
    </a>
  </p>
  <p class="mt-3 text-muted font-light" data-missing hidden>No member has that username.</p>
</header>

<script>
  import { wireProfile } from '../scripts/profile';

  wireProfile();
  document.addEventListener('astro:page-load', wireProfile);
</script>
