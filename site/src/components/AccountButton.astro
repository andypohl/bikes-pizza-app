---
// Header button for the account page, which the site serves itself at
// /account/ (copied from web/public at build time). Sharing the origin means
// the Firebase Auth session is visible here, so the button reads "Sign in"
// when signed out and "Account" when signed in. Until the state is known it
// shows the neutral label.
---

<a
  id="account-button"
  href="/account/?mode=account"
  class="inline-flex items-center gap-2 px-4 py-3 rounded-full bg-stone-200 dark:bg-slate-700 hover:bg-stone-300 dark:hover:bg-slate-600 text-stone-800 dark:text-stone-100 text-sm font-medium tracking-wide transition-colors duration-200"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
  </svg>
  <span id="account-label">Account</span>
</a>

<script>
  import { onAuth, signInHref, type SiteUser } from '../scripts/auth';

  let current: { user: SiteUser; known: boolean } = { user: null, known: false };

  function render() {
    const link = document.getElementById('account-button') as HTMLAnchorElement | null;
    const label = document.getElementById('account-label');
    if (!link || !label || !current.known) return;
    if (current.user) {
      link.href = '/account/?mode=account';
      label.textContent = 'Account';
      link.title = current.user.displayName || current.user.email || 'Account';
    } else {
      link.href = signInHref(location.pathname + location.search);
      label.textContent = 'Sign in';
      link.title = 'Sign in or create an account';
    }
  }

  onAuth((user, known) => {
    current = { user, known };
    render();
  });
  document.addEventListener('astro:page-load', render);
</script>
