---
// One news article in full: title, date, photo when it has one, the body
// and the credit.
import { creditOf, memberPath, postPath, responsive, type Post } from '../lib/posts';
import { formatDate } from '../utils/format';

interface Props {
  post: Post;
  /** In the feed the title links to the article's own page. */
  linkTitle?: boolean;
  /** Load the photo right away (the first article on the page). */
  eager?: boolean;
}

const { post, linkTitle = false, eager = false } = Astro.props;
// The photo keeps its proportions, as wide as the text at most and never
// taller than 22.5rem (360px), the same cap as the app's article image.
const image = post.image ? responsive(post.image) : null;
---

<article class="max-w-3xl mx-auto">
  <h1 class="text-3xl sm:text-4xl font-light tracking-wide mb-2 text-ink">
    {linkTitle ? <a href={postPath(post)} class="hover:text-spice transition-colors duration-300">{post.title}</a> : post.title}
  </h1>
  <p class="text-lg font-light mb-8 text-muted tracking-wide">{formatDate(post.publishedAt)}</p>

  {
    image && post.image && (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 768px) 48rem, 100vw"
        alt={post.title}
        width={post.image.width}
        height={post.image.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="block mx-auto w-auto h-auto max-w-full max-h-[22.5rem] rounded-lg mb-8"
      />
    )
  }

  <div class="post-body text-ink leading-relaxed font-light text-lg" set:html={post.html} />

  {
    creditOf(post) && (
      <p class="mt-8 text-sm text-muted">
        By{' '}
        {post.credit?.username ? (
          <a href={memberPath(post.credit)} class="text-ink underline decoration-line underline-offset-4 hover:text-spice">
            {post.credit.username}
          </a>
        ) : (
          <span class="text-ink">{creditOf(post)}</span>
        )}
      </p>
    )
  }
</article>
