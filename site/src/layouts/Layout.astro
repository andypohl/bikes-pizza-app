---
import { ClientRouter } from 'astro:transitions';
import AccountButton from '../components/AccountButton.astro';
import StoreButton from '../components/StoreButton.astro';
import CartButton from '../components/CartButton.astro';
import HomeButton from '../components/HomeButton.astro';
import SubmitButton from '../components/SubmitButton.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Pizza and bikes, one photo at a time.', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The brand in the header is the front page's heading; elsewhere it is a link.
const Brand = Astro.url.pathname === '/' ? 'h1' : 'p';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#80c6c4" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bikes.pizza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Theme initialisation, inline so there is no flash of the wrong theme.
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        window.localStorage.setItem('theme', theme);
      })();
    </script>
    <style>
      .group-hover\:scale-102:hover {
        transform: scale(1.01);
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-surface text-ink font-inter transition-colors duration-300"
    transition:animate="initial"
  >
    <div class="fixed top-6 left-6 right-6 z-50 flex flex-wrap items-center justify-end gap-3 pointer-events-none [&>*]:pointer-events-auto">
      <HomeButton />
      <SubmitButton />
      <StoreButton />
      <CartButton />
      <AccountButton />
      <ThemeToggle />
    </div>

    <!-- The fixed buttons above sit to the right of the brand on wide
         screens and above it (wrapping to a second row) on narrow ones. -->
    <header class="container mx-auto px-6 pt-32 xl:pt-10">
      <Brand class="m-0">
        <a href="/" class="group inline-flex items-center gap-4 sm:gap-5">
          <img src="/logo.png" alt="" width="512" height="512" class="h-14 w-14 sm:h-20 sm:w-20 transition-transform duration-500 group-hover:rotate-12" />
          <span class="text-4xl sm:text-5xl font-light tracking-wide text-ink group-hover:text-spice transition-colors duration-300">
            bikes.pizza
          </span>
        </a>
      </Brand>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-surface-2 mt-16 py-8" transition:name="footer">
      <div class="container mx-auto px-6 text-center text-muted text-sm font-light">
        <p>&copy; {new Date().getFullYear()} bikes.pizza</p>
        <p class="mt-2">
          Theme:{' '}
          <a
            href="https://github.com/EmaSuriano/astro-frame-shift"
            class="hover:text-spice transition-colors"
          >
            Astro Frame Shift
          </a>
          {' by '}
          <a
            href="https://github.com/EmaSuriano"
            class="hover:text-spice transition-colors"
          >
            Ema Suriano
          </a>
          {' · Built with '}
          <a href="https://astro.build" class="hover:text-spice transition-colors">
            Astro
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
