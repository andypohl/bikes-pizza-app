---
import { ClientRouter } from 'astro:transitions';
import AccountButton from '../components/AccountButton.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Pizza and bikes, one photo at a time.', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bikes.pizza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Theme initialisation, inline so there is no flash of the wrong theme.
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        window.localStorage.setItem('theme', theme);
      })();
    </script>
    <style>
      .masonry-container {
        column-gap: 1.5rem;
      }
      .masonry-item {
        display: inline-block;
        width: 100%;
      }
      .group-hover\:scale-102:hover {
        transform: scale(1.01);
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-stone-50 dark:bg-slate-900 font-inter transition-colors duration-300"
    transition:animate="initial"
  >
    <div class="fixed top-6 right-6 z-50 flex items-center gap-3">
      <AccountButton />
      <ThemeToggle />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-stone-100 dark:bg-slate-800 mt-16 py-8" transition:name="footer">
      <div class="container mx-auto px-6 text-center text-stone-600 dark:text-gray-400 text-sm font-light">
        <p>&copy; {new Date().getFullYear()} bikes.pizza</p>
        <p class="mt-2">
          Theme:{' '}
          <a
            href="https://github.com/EmaSuriano/astro-frame-shift"
            class="hover:text-stone-800 dark:hover:text-gray-200 transition-colors"
          >
            Astro Frame Shift
          </a>
          {' by '}
          <a
            href="https://github.com/EmaSuriano"
            class="hover:text-stone-800 dark:hover:text-gray-200 transition-colors"
          >
            Ema Suriano
          </a>
          {' · Built with '}
          <a href="https://astro.build" class="hover:text-stone-800 dark:hover:text-gray-200 transition-colors">
            Astro
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
