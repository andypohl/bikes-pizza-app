---
// The news: the newest article in full, with the category filter above it
// so the gallery is a click away. Every article also has its own page
// under /news/<slug>/, which is the canonical one.
import Layout from '../../layouts/Layout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import NewsArticle from '../../components/NewsArticle.astro';
import { CATEGORIES, getNewsPosts, postPath, summaryOf } from '../../lib/sanity';

const news = await getNewsPosts();
const post = news[0] ?? null;
const older = news[1] ?? null;
---

<Layout
  title="News | bikes.pizza"
  description={post ? summaryOf(post) : 'News from bikes.pizza.'}
  canonical={post ? postPath(post) : undefined}
>
  <main class="container mx-auto px-6 pt-10 pb-24">
    <CategoryFilters categories={CATEGORIES} active="news" newsHref="/news/" />
    {post ? <NewsArticle post={post} older={older} newer={null} /> : <p class="text-lg font-light text-muted">No news yet. Check back soon.</p>}
  </main>
</Layout>
