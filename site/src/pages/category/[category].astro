---
import Layout from '../../layouts/Layout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import PostGrid from '../../components/PostGrid.astro';
import FeaturedRow from '../../components/FeaturedRow.astro';
import WavyDivider from '../../components/WavyDivider.astro';
import { splitFeatured } from '../../lib/sanity';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const { categoryOf, getPosts } = await import('../../lib/sanity');
  const posts = await getPosts();
  const categories = [...new Set(posts.map(categoryOf))].sort((a, b) => a.localeCompare(b));
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: {
      category,
      categories,
      posts: posts.filter((post) => categoryOf(post) === category),
    },
  }));
}

const { category, categories, posts } = Astro.props;
const { featured, rest } = splitFeatured(posts, posts.length ? [posts[0].feed] : []);
---

<Layout title={`${category} | bikes.pizza`}>
  <main class="container mx-auto px-6 py-16">
    <h1 class="text-5xl font-light tracking-wide mb-8 text-stone-900 dark:text-stone-100">
      <a href="/">bikes.pizza</a>
    </h1>

    <CategoryFilters categories={categories} active={slugify(category)} />
    <FeaturedRow posts={featured} />
    {featured.length > 0 && rest.length > 0 && <WavyDivider />}
    <PostGrid posts={rest} />
  </main>
</Layout>
