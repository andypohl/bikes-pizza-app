---
import Layout from '../../../layouts/Layout.astro';
import CategoryFilters from '../../../components/CategoryFilters.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { ALL_PRODUCTS } from '../../../lib/shop';
import { slugify } from '../../../utils/slug';

export async function getStaticPaths() {
  const { categoriesOf, getProducts } = await import('../../../lib/shop');
  const products = await getProducts();
  const categories = categoriesOf(products);
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, categories, products: products.filter((product) => product.category === category) },
  }));
}

const { category, categories, products } = Astro.props;
---

<Layout title={`${category} | Shop | bikes.pizza`}>
  <main class="container mx-auto px-6 py-16">
    <h1 class="text-5xl font-light tracking-wide mb-8 text-stone-900 dark:text-stone-100">
      <a href="/">bikes.pizza</a> <a href="/shop/" class="text-stone-400 dark:text-slate-500">shop</a>
    </h1>

    <CategoryFilters categories={categories} active={slugify(category)} allHref="/shop/" allLabel={ALL_PRODUCTS} categoryBase="/shop/category/" />
    <ProductGrid products={products} />
  </main>
</Layout>
