---
import Layout from '../../layouts/Layout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { hasChoices, priceOf, responsiveShopify, shopifyImage, STORE_URL, type Product } from '../../lib/shop';

export async function getStaticPaths() {
  const RELATED_LIMIT = 8;
  const { getProducts } = await import('../../lib/shop');
  const products = await getProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product, related: products.filter((other) => other.id !== product.id).slice(0, RELATED_LIMIT) },
  }));
}

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const image = product.image ? responsiveShopify(product.image, [800, 1200, 1600]) : null;
const ogImage = product.image ? shopifyImage(product.image, 1200, 630) : undefined;
const choices = hasChoices(product);
const first = product.variants.find((variant) => variant.available) ?? product.variants[0];
const plain = product.descriptionHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
---

<Layout title={`${product.title} | Shop | bikes.pizza`} description={plain || product.title} image={ogImage}>
  <main class="container mx-auto px-6 pt-10 pb-16">
    <a
      href="/shop/"
      class="inline-flex items-center mb-12 text-muted hover:text-spice transition-colors duration-300 font-light"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
          clip-rule="evenodd"></path>
      </svg>
      Back to the shop
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      <div
        class="lg:col-span-2 overflow-hidden rounded-lg max-h-[85vh] flex items-center justify-center bg-transparent"
        transition:name={`product-${product.id}`}
      >
        {
          image ? (
            <img
              src={image.src}
              srcset={image.srcset}
              sizes="(min-width: 1024px) 66vw, 100vw"
              alt={product.title}
              loading="eager"
              decoding="async"
              class="w-auto h-auto object-contain max-h-[85vh] max-w-full rounded-lg"
            />
          ) : (
            <div class="w-full aspect-[4/3] rounded-lg bg-surface-2" />
          )
        }
      </div>

      <div class="lg:col-span-1 py-4 lg:sticky lg:top-8">
        <h1 class="text-3xl font-light tracking-wide mb-2 text-ink">{product.title}</h1>
        <p class="text-lg font-light mb-8 text-muted tracking-wide" id="price">{priceOf(product)}</p>

        {
          product.descriptionHtml && (
            <div class="post-body mb-8 text-ink leading-relaxed font-light" set:html={product.descriptionHtml} />
          )
        }

        {
          first ? (
            <form
              class="buy"
              data-handle={product.handle}
              data-title={product.title}
              data-image={product.image ?? ''}
              data-store-url={STORE_URL}
            >
              {choices && (
                <label class="block mb-4 text-sm">
                  <span class="font-medium text-muted">Choose</span>
                  <select
                    name="variant"
                    class="mt-1 block w-full rounded-lg border border-line bg-field text-ink px-3 py-2"
                  >
                    {product.variants.map((variant) => (
                      <option
                        value={variant.id}
                        data-price={variant.price}
                        data-title={variant.title}
                        data-image={variant.image ?? ''}
                        disabled={!variant.available}
                        selected={variant.id === first.id}
                      >
                        {variant.title}
                        {variant.available ? '' : ' (sold out)'}
                      </option>
                    ))}
                  </select>
                </label>
              )}
              <div class="flex items-center gap-3 mb-4 text-sm">
                <span class="font-medium text-muted">Quantity</span>
                <div class="inline-flex items-center gap-1" role="group" aria-label="Quantity">
                  <button type="button" class="qty-btn" data-dec aria-label="One fewer">−</button>
                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    max="99"
                    inputmode="numeric"
                    class="w-14 text-center rounded-lg border border-line bg-field text-ink px-2 py-1.5"
                    aria-label="Quantity"
                  />
                  <button type="button" class="qty-btn" data-inc aria-label="One more">+</button>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button
                  type="submit"
                  id="add-to-cart"
                  data-variant={first.id}
                  data-price={first.price}
                  data-variant-title={choices ? first.title : ''}
                  disabled={!first.available}
                  class:list={[
                    'inline-flex items-center justify-center w-full px-5 py-3 rounded-full text-sm font-medium tracking-wide transition-colors duration-200',
                    first.available
                      ? 'bg-pill text-ink hover:bg-pill-hover'
                      : 'bg-pill text-muted cursor-not-allowed',
                  ]}
                >
                  {first.available ? 'Add to cart' : 'Sold out'}
                </button>
                <button
                  type="button"
                  id="buy-now"
                  disabled={!first.available}
                  class:list={[
                    'inline-flex items-center justify-center w-full px-5 py-3 rounded-full text-sm font-medium tracking-wide transition-colors duration-200',
                    first.available
                      ? 'bg-accent text-on-accent hover:bg-accent-hover'
                      : 'bg-pill text-muted cursor-not-allowed',
                  ]}
                >
                  Buy it now
                </button>
              </div>
              <p id="added" class="mt-3 text-sm font-light text-muted" role="status" aria-live="polite" hidden></p>
              <p class="mt-3 text-xs font-light text-muted">Checkout opens on our Shopify store.</p>
            </form>
          ) : (
            <p class="text-muted font-light">Not available right now.</p>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-light tracking-wide mb-8 text-ink">More from the shop</h2>
          <ProductGrid products={related} eager={0} />
        </div>
      )
    }
  </main>
</Layout>

<dialog id="buy-dialog" class="buy-dialog bg-surface text-ink">
  <form method="dialog" class="p-6">
    <h2 class="text-xl font-light tracking-wide mb-2">Check out what?</h2>
    <p class="text-sm font-light text-muted mb-6">
      You have <span id="buy-dialog-count"></span> in your cart. Buy just this item, or everything together?
    </p>
    <div class="grid gap-3">
      <button
        value="item"
        class="inline-flex items-center justify-center w-full px-5 py-3 rounded-full text-sm font-medium tracking-wide bg-accent text-on-accent hover:bg-accent-hover transition-colors duration-200"
      >
        Just this item
      </button>
      <button
        value="all"
        class="inline-flex items-center justify-center w-full px-5 py-3 rounded-full text-sm font-medium tracking-wide bg-pill text-ink hover:bg-pill-hover transition-colors duration-200"
      >
        This item and my cart
      </button>
      <button value="cancel" class="text-sm font-light text-muted hover:text-spice py-1">Cancel</button>
    </div>
  </form>
</dialog>

<style>
  .qty-btn {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-pill);
    color: var(--color-ink);
  }
  .qty-btn:hover {
    background: var(--color-pill-hover);
  }
  .buy-dialog {
    /* Tailwind's reset zeroes a dialog's margin; centre it again. */
    margin: auto;
    width: min(24rem, calc(100vw - 2rem));
    border: 0;
    border-radius: 1rem;
    padding: 0;
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.3);
  }
  .buy-dialog::backdrop {
    background: rgb(12 10 9 / 0.5);
  }
</style>

<script>
  import { addItem, checkoutUrlFor, countOf, readCart, type CartItem } from '../../scripts/cart';
  import { formatMoney } from '../../scripts/cart';

  // The quantity here is stateless: "Add to cart" adds that many (the
  // badge goes up by it, without opening the cart), and "Buy it now"
  // checks out that many of this item straight away. If the cart already
  // has something, Buy it now first asks whether to include it.
  function wire() {
    const form = document.querySelector<HTMLFormElement>('form.buy');
    const button = document.getElementById('add-to-cart') as HTMLButtonElement | null;
    // `astro:page-load` also fires on the first load, so wire each form once.
    if (!form || !button || form.dataset.wired) return;
    form.dataset.wired = 'true';
    const select = form.querySelector<HTMLSelectElement>('select[name=variant]');
    const quantityInput = form.querySelector<HTMLInputElement>('input[name=quantity]');
    const price = document.getElementById('price');
    const added = document.getElementById('added');
    const buy = document.getElementById('buy-now') as HTMLButtonElement | null;
    const dialog = document.getElementById('buy-dialog') as HTMLDialogElement | null;
    const storeUrl = form.dataset.storeUrl ?? '';

    const quantity = () => Math.min(99, Math.max(1, Math.floor(Number(quantityInput?.value) || 1)));
    const setQuantity = (n: number) => {
      if (quantityInput) quantityInput.value = String(Math.min(99, Math.max(1, n)));
    };
    form.querySelector('[data-dec]')?.addEventListener('click', () => setQuantity(quantity() - 1));
    form.querySelector('[data-inc]')?.addEventListener('click', () => setQuantity(quantity() + 1));
    quantityInput?.addEventListener('change', () => setQuantity(quantity()));

    const chosen = (): Omit<CartItem, 'quantity'> | null => {
      const option = select?.selectedOptions[0];
      const variantId = Number(option?.value ?? button.dataset.variant);
      if (!variantId) return null;
      return {
        variantId,
        handle: form.dataset.handle ?? '',
        title: form.dataset.title ?? '',
        variantTitle: option ? (option.dataset.title ?? '') : (button.dataset.variantTitle ?? ''),
        price: Number(option?.dataset.price ?? button.dataset.price),
        image: (option?.dataset.image || form.dataset.image) || null,
      };
    };

    select?.addEventListener('change', () => {
      const item = chosen();
      if (price && item) price.textContent = formatMoney(item.price);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const item = chosen();
      if (!item) return;
      const n = quantity();
      addItem(item, n);
      if (added) {
        added.textContent = n === 1 ? 'Added to your cart.' : `Added ${n} to your cart.`;
        added.hidden = false;
      }
    });

    const checkout = (lines: CartItem[]) => {
      location.href = checkoutUrlFor(storeUrl, lines);
    };

    buy?.addEventListener('click', () => {
      const item = chosen();
      if (!item) return;
      const line: CartItem = { ...item, quantity: quantity() };
      const cart = readCart();
      if (cart.length === 0 || !dialog) return checkout([line]);
      const n = countOf(cart);
      const count = document.getElementById('buy-dialog-count');
      if (count) count.textContent = n === 1 ? '1 item' : `${n} items`;
      dialog.returnValue = 'cancel';
      dialog.addEventListener(
        'close',
        () => {
          if (dialog.returnValue === 'item') checkout([line]);
          if (dialog.returnValue === 'all') {
            // Merge this item into the cart's lines for one checkout.
            const merged = cart.map((existing) =>
              existing.variantId === line.variantId ? { ...existing, quantity: existing.quantity + line.quantity } : existing,
            );
            if (!merged.some((existing) => existing.variantId === line.variantId)) merged.push(line);
            checkout(merged);
          }
        },
        { once: true },
      );
      dialog.showModal();
    });
  }
  document.addEventListener('astro:page-load', wire);
</script>